# EditorConfig is awesome: https://editorconfig.org
root = true

# Global settings for all files
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript files
[*.js]
indent_size = 2

# JSON files
[*.json]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = false  # JSON often doesn't need this

# XML files
[*.xml]
indent_size = 2
insert_final_newline = true

# Markdown files (optional)
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = off  explain
